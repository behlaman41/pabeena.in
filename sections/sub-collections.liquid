{%- if section.settings.menu != blank -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
      --image-position: {{ section.settings.image_position }};
    }
  {%- endstyle -%}
  {{ 'component-collection-subs.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="{{ 'component-card.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-card.css' | asset_url | stylesheet_tag }}</noscript>
  <div class="sub-collection-section section--padding page-width">
    {%- liquid
      assign current_items = ''
      for link in section.settings.menu.links
        if link.active and link.levels > 0 and link.child_active == false
          unless current_items contains link.title
            render 'sub-collections', sub_collection_links: link.links
            assign current_items = current_items | append: link.title
          endunless
        endif
        for sub_link in link.links
          if sub_link.active and sub_link.levels > 0 and sub_link.child_active == false
            unless current_items contains sub_link.title
              render 'sub-collections', sub_collection_links: sub_link.links
              assign current_items = current_items | append: sub_link.title
            endunless
          endif
          for sub_sub_link in sub_link.links
            if sub_sub_link.active and sub_sub_link.url == sub_link.url
              unless current_items contains sub_sub_link.title
                render 'sub-collections', parent_url: sub_link.url, sub_collection_links: sub_link.links
                assign current_items = current_items | append: sub_sub_link.title
              endunless
            elsif sub_sub_link.active and sub_sub_link.levels > 0
              unless current_items contains sub_sub_link.title
                render 'sub-collections', sub_collection_links: sub_sub_link.links
                assign current_items = current_items | append: sub_sub_link.title
              endunless
            endif
          endfor
        endfor
      endfor
    -%}
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Sub Collections",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Paragraph"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "range",
      "id": "per_row",
      "label": "Per Row",
      "default": 5,
      "min": 2,
      "max": 5,
      "step": 1
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2",
      "label": "2"
    },
    {
      "type": "checkbox",
      "id": "horizontal_on_mobile",
      "default": true,
      "label": "horizontal on mobile"
    },
    {
      "type": "header",
      "content": "Collection Card"
    },
    {
      "type": "select",
      "id": "grid_image",
      "options": [
        {
          "value": "product",
          "label": "Product"
        },
        {
          "value": "collection",
          "label": "Collection"
        }
      ],
      "default": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "adapt"
        },
        {
          "value": "square",
          "label": "square"
        },
        {
          "value": "portrait",
          "label": "portrait"
        },
        {
          "value": "landscape",
          "label": "landscape"
        },
        {
          "value": "wide",
          "label": "wide"
        }
      ],
      "default": "adapt",
      "label": "adapt"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "20% 0",
          "label": "20% 0"
        },
        {
          "value": "top center",
          "label": "top center"
        },
        {
          "value": "80% 0",
          "label": "80% 0"
        },
        {
          "value": "20% 50%",
          "label": "20% 50%"
        },
        {
          "value": "center center",
          "label": "center center"
        },
        {
          "value": "80% 50%",
          "label": "80% 50%"
        },
        {
          "value": "20% 100%",
          "label": "20% 100%"
        },
        {
          "value": "bottom center",
          "label": "bottom center"
        },
        {
          "value": "80% 100%",
          "label": "80% 100%"
        }
      ],
      "default": "center center",
      "label": "center center"
    },
    {
      "type": "checkbox",
      "id": "apply_overlay",
      "default": true,
      "label": "apply overlay"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Sub Collections"
    }
  ]
}
{% endschema %}