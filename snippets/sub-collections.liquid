{%- liquid
  assign grid_class = 'grid grid--2-col'
  if section.settings.columns_mobile == '1'
    assign grid_class = grid_class | append: ' grid--1-col-mobile'
  endif
  if section.settings.per_row == 3
    assign grid_class = grid_class | append: ' grid--3-col-tablet grid--3-col-desktop'
  elsif section.settings.per_row == 4
    assign grid_class = grid_class | append: ' grid--3-col-tablet grid--4-col-desktop'
  else
    assign grid_class = grid_class | append: ' grid--3-col-tablet grid--5-col-desktop'
  endif
-%}
<slider-component class="collection sub-collection slider-mobile-gutter sub-categories circular-collection-section">
  <ul
    id="Slider-{{ section.id }}"
    class="collection-list {{ grid_class }}{% if section.settings.apply_overlay %} collection-list--contrast{% endif %}{% if section.settings.horizontal_on_mobile %} collection-list--horizontal-mobile{% endif %} slider slider--tablet slider--tablet-up"
    role="list"
  >
    {%- for sub_collection_link in sub_collection_links -%}
      {%- if sub_collection_link.type == 'collection_link' -%}
        {%- unless parent_url == sub_collection_link.url -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="grid__item collection-list__item slider__slide"
          >
            {% render 'card-collection-sub',
              collection: sub_collection_link.object,
              collection_url: sub_collection_link.url,
              collection_title: sub_collection_link.title,
              grid_image: section.settings.grid_image,
              image_ratio: section.settings.image_ratio,
              image_position: section.settings.image_position
            -%}
          </li>
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  </ul>
</slider-component>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>

<script type="text/javascript" src="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<style>
    .circular-collection-section ul.collection-list {
      overflow: hidden;
  }
    .circular-collection-section ul.collection-list li.grid__item {
      padding: 0 10px;
  }

    .circular-collection-section ul.collection-list button.slick-prev.slick-arrow {
      position: absolute;
      left: 0;
      top: 35%;
      transform: translate(0, -50%);
      z-index: 2;
      padding: 0;
      width: 4rem;
      height: 4rem;
      display: flex;
      align-items: center;
      z-index: 5;
      color: rgb(var(--color-foreground));
      background-color: transparent;
      transition: opacity var(--duration-default) ease;
      justify-content: flex-start;
      cursor:pointer;
  }
   .circular-collection-section ul.collection-list button.slick-next.slick-arrow {
      position: absolute;
      right: 0;
      top: 35%;
      transform: translate(0, -50%);
      padding: 0;
      width: 4rem;
      height: 4rem;
      align-items: center;
      z-index: 5;
      color: rgb(var(--color-foreground));
      background-color: transparent;
      transition: opacity var(--duration-default) ease;
      justify-content: flex-end;
     cursor:pointer;
  }
  .circular-collection-section ul.collection-list button.slick-prev.slick-arrow svg.flickity-button-icon {
      position: absolute;
      left: 25%;
      top: 25%;
      width: 50%;
      height: 50%;
  }
    .circular-collection-section ul.collection-list button.slick-next.slick-arrow svg.flickity-button-icon {
      position: absolute;
      left: 25%;
      top: 25%;
      width: 50%;
      height: 50%;
  }
    .circular-collection-section ul.collection-list button.slick-prev.slick-arrow, .circular-collection-section ul.collection-list button.slick-next.slick-arrow {
      border: 0;
  }
    .circular-collection-section .media-wrapper {
    border-radius: 1000px;
          margin: 10px;
  }
  .circular-collection-section ul.collection-list {
    justify-content: start;
    flex-wrap: nowrap;
    overflow-x: auto !important;
  }
  .circular-collection-section ul.collection-list .card__text {
      position: relative;
      color: #000;
      padding: 0;
      text-align: center;
      display: flex;
      justify-content: center;
  }
  .circular-collection-section .media-wrapper .media, .circular-collection-section .media-wrapper .media img {
    position: unset;
    padding: 0;
}
  .circular-collection-section .media-wrapper .media, .circular-collection-section .media-wrapper .media img {
    position: unset;
    padding: 0;
    border-radius: 1000px;
    width: 80px;
    height: 80px;
    margin: 0 auto;
    object-fit: contain;
}
  .circular-collection-section .media-wrapper .media img {
    background: #fff;
        border: 1px solid #000;
}
  .sub-collection .collection-list__item .card-information__text {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
}
  .circular-collection-section ul.collection-list button.slick-arrow svg.flickity-button-icon path.arrow {
    fill: #fff;
}
  .circular-collection-section ul.collection-list button.slick-arrow {
    display: flex;
    align-items: center !important;
    justify-content: center !important;
    background: #000 !important;
    border-radius: 100px;
}
  @media only screen and (min-width: 768px) {
    .circular-collection-section ul.collection-list::-webkit-scrollbar {
      display: none;
    }
  }
  .circular-collection-section ul.collection-list .grid__item {
    max-width: 10% !important;
  }
    .circular-collection-section ul.collection-list {
      display: flex;
      justify-content: center;
  }
  @media screen and (min-width: 750px){
    .circular-collection-section ul.collection-list button.slick-prev.slick-arrow svg.flickity-button-icon {
      width: 1.6rem;
      height: 1.6rem;
      position: static;
  }
  .circular-collection-section ul.collection-list button.slick-next.slick-arrow svg.flickity-button-icon {
      width: 1.6rem;
      height: 1.6rem;
      position: static;
  }
  }
    @media screen and (max-width:749px){
      .circular-collection-section ul.collection-list li.grid__item .media-wrapper {
      position: relative;
      width: 100%;
      height: auto;
  }
      .circular-collection-section ul.collection-list li.grid__item .media-wrapper .media {
      padding-bottom: 0;
  }
      .circular-collection-section .media-wrapper .media, .circular-collection-section .media-wrapper .media img {
    width: 100px;
    height: 100px;
}
      .circular-collection-section .media-wrapper {
    margin: 0;
    margin-bottom: 1rem;
}
    }
</style>
<div style="display:none;">
  {% assign slick_variable = 0 %}
  {%- for sub_collection_link in sub_collection_links -%}
    {% assign slick_variable = slick_variable | plus: 1 %}
  {%- endfor -%}
</div>
{% if slick_variable > 8 %}
  <script>
      $('.circular-collection-section ul.collection-list').slick({
      dots: false,
      infinite: true,
      arrows: true,
      speed: 300,
      slidesToShow: {{slick_variable | minus: 2}},
      slidesToScroll: 1,
      prevArrow: '<button type="button" class="slick-prev"><svg class="flickity-button-icon" viewBox="0 0 100 100"><title>Previous</title><path d="M29.043 19.756l-28.125 28.125c-0.605 0.606-0.918 1.406-0.918 2.031s0.305 1.599 0.916 2.209l28.125 28.125c1.221 1.221 3.199 1.221 4.418 0s1.221-3.199 0-4.418l-22.793-22.793h86.209c1.727 0 3.125-1.398 3.125-2.949 0-1.727-1.398-3.125-3.125-3.125h-86.211l22.793-22.793c1.221-1.221 1.221-3.199 0-4.418s-3.203-1.217-4.414 0.006z" class="arrow"></path></svg></button>',
      nextArrow: '<button type="button" class="slick-next"><svg class="flickity-button-icon" viewBox="0 0 100 100"><title>Next</title><path d="M29.043 19.756l-28.125 28.125c-0.605 0.606-0.918 1.406-0.918 2.031s0.305 1.599 0.916 2.209l28.125 28.125c1.221 1.221 3.199 1.221 4.418 0s1.221-3.199 0-4.418l-22.793-22.793h86.209c1.727 0 3.125-1.398 3.125-2.949 0-1.727-1.398-3.125-3.125-3.125h-86.211l22.793-22.793c1.221-1.221 1.221-3.199 0-4.418s-3.203-1.217-4.414 0.006z" class="arrow" transform="translate(100, 100) rotate(180)"></path></svg></button>',
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 4,
            slidesToScroll: 1
          }
        },
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 1
          }
        },
        {
          breakpoint: 480,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 1
          }
        }
      ]
    });
  </script>
{% else %}
  <script>
      if($(window).width() < 767){
      $('.circular-collection-section ul.collection-list').slick({
      dots: false,
      infinite: true,
      arrows: true,
      speed: 300,
      slidesToShow: 2,
      slidesToScroll: 1,
      prevArrow: '<button type="button" class="slick-prev"><svg class="flickity-button-icon" viewBox="0 0 100 100"><title>Previous</title><path d="M29.043 19.756l-28.125 28.125c-0.605 0.606-0.918 1.406-0.918 2.031s0.305 1.599 0.916 2.209l28.125 28.125c1.221 1.221 3.199 1.221 4.418 0s1.221-3.199 0-4.418l-22.793-22.793h86.209c1.727 0 3.125-1.398 3.125-2.949 0-1.727-1.398-3.125-3.125-3.125h-86.211l22.793-22.793c1.221-1.221 1.221-3.199 0-4.418s-3.203-1.217-4.414 0.006z" class="arrow"></path></svg></button>',
      nextArrow: '<button type="button" class="slick-next"><svg class="flickity-button-icon" viewBox="0 0 100 100"><title>Next</title><path d="M29.043 19.756l-28.125 28.125c-0.605 0.606-0.918 1.406-0.918 2.031s0.305 1.599 0.916 2.209l28.125 28.125c1.221 1.221 3.199 1.221 4.418 0s1.221-3.199 0-4.418l-22.793-22.793h86.209c1.727 0 3.125-1.398 3.125-2.949 0-1.727-1.398-3.125-3.125-3.125h-86.211l22.793-22.793c1.221-1.221 1.221-3.199 0-4.418s-3.203-1.217-4.414 0.006z" class="arrow" transform="translate(100, 100) rotate(180)"></path></svg></button>',
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 1
          }
        },
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 1
          }
        },
        {
          breakpoint: 480,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 1
          }
        }
      ]
    });
      }
  </script>
{% endif %}
